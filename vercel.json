{
  "alias": ["genie127.com", "www.genie127.com"],
  "crons": [
    {
      "path": "/api/cron/refresh-regulations",
      "schedule": "0 6 1,15 * *"
    },
    {
      "path": "/api/cron/refresh-resources",
      "schedule": "0 7 */3 * *"
    }
  ],
  "headers": [
    {
      "source": "/genie.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
