{
  "name": "uigen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:daemon": "next dev --turbopack > logs.txt 2>&1 & echo 'Server started, writing logs to logs.txt'",
    "build": "prisma generate && next build",
    "build:production": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev && node scripts/apply-regulation-migration.js",
    "db:reset": "npx prisma migrate reset --force && node scripts/apply-regulation-migration.js",
    "regulations:refresh": "node scripts/refresh-regulations.js",
    "deploy:check": "node deploy-check.js",
    "build:verify": "node scripts/build-and-verify.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.16",
    "@ai-sdk/anthropic": "^2.0.12",
    "@ai-sdk/gateway": "^3.0.84",
    "@ai-sdk/react": "^2.0.32",
    "@babel/standalone": "^7.27.6",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.10.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@stripe/stripe-js": "^9.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.11",
    "ai": "^5.0.162",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.517.0",
    "next": "^15.5.14",
    "nodemailer": "^8.0.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "server-only": "^0.0.1",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "jsdom": "^26.1.0",
    "prisma": "^6.10.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
