// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  MONTHLY
  MONTHLY_PLUS
  YEARLY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]

  // Subscription
  subscriptionTier      SubscriptionTier @default(FREE)
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?          @unique
  subscriptionStatus    String?
  subscriptionPeriodEnd DateTime?

  // Rate limiting
  dailyQuestionCount   Int       @default(0)
  dailyQuestionResetAt DateTime?

  // Multi-seat accounts (max 3 users per paid account)
  accountOwnerId String?
  accountOwner   User?   @relation("AccountMembers", fields: [accountOwnerId], references: [id])
  accountMembers User[]  @relation("AccountMembers")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  messages  String   @default("[]")
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stores the latest fetched regulatory updates for the aid agent
model RegulationUpdate {
  id          String    @id @default(cuid())
  category    String    // "TitleIV" | "IRS" | "Legislative" | "SchoolUpdates"
  title       String
  summary     String
  sourceUrl   String?
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
}

// Audit log of every scheduled / manual fetch
model RegulationFetchLog {
  id          String   @id @default(cuid())
  fetchedAt   DateTime @default(now())
  success     Boolean
  updateCount Int      @default(0)
  error       String?
}

model GuestSession {
  id                   String    @id @default(cuid())
  sessionId            String    @unique
  dailyQuestionCount   Int       @default(0)
  dailyQuestionResetAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
