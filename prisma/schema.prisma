// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  MONTHLY // legacy
  MONTHLY_PLUS // legacy
  YEARLY // legacy
  PRO
  TEAM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  // Subscription
  subscriptionTier      SubscriptionTier @default(FREE)
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?          @unique
  subscriptionStatus    String?
  subscriptionPeriodEnd DateTime?

  // Rate limiting
  dailyQuestionCount   Int       @default(0)
  dailyQuestionResetAt DateTime?

  // Fantasy agent usage credits. Held in tenths of a cent so a sub-cent turn
  // still deducts something real instead of rounding to zero.
  fantasyCreditsMills Int            @default(0)
  fantasyUsage        FantasyUsage[]

  // Email verification
  emailVerified           Boolean   @default(true)
  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?

  // Password reset
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  // Multi-seat accounts (max 3 users per paid account)
  accountOwnerId String?
  accountOwner   User?   @relation("AccountMembers", fields: [accountOwnerId], references: [id])
  accountMembers User[]  @relation("AccountMembers")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  messages  String   @default("[]")
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stores the latest fetched regulatory updates for the aid agent
model RegulationUpdate {
  id          String    @id @default(cuid())
  category    String // "TitleIV" | "IRS" | "Legislative" | "SchoolUpdates"
  title       String
  summary     String
  sourceUrl   String?
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
}

// Audit log of every scheduled / manual fetch
model RegulationFetchLog {
  id          String   @id @default(cuid())
  fetchedAt   DateTime @default(now())
  success     Boolean
  updateCount Int      @default(0)
  error       String?
}

// Audit log for scheduled resource freshness checks (every 3 days)
model ResourceRefreshLog {
  id          String   @id @default(cuid())
  refreshedAt DateTime @default(now())
  success     Boolean
  note        String?
}

model GuestSession {
  id                   String    @id @default(cuid())
  sessionId            String    @unique
  dailyQuestionCount   Int       @default(0)
  dailyQuestionResetAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// One row per billed fantasy-agent turn. Keeps an auditable trail so a user
/// can see exactly what a turn cost and we can reconcile against Anthropic.
model FantasyUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// Raw Anthropic cost, tenths of a cent.
  rawCostMills     Int      @default(0)
  /// What the user was actually charged (raw x markup), tenths of a cent.
  billedMills      Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
